# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Render Pro (IA de imagem). Fica só no servidor, nunca vai para o navegador.
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Chave de serviço do Supabase (Project Settings > API > service_role). Só no servidor: usada pelo webhook do banco.
SUPABASE_SERVICE_ROLE_KEY=

# Open Finance (Pluggy): dashboard.pluggy.ai > Applications
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SANDBOX=1
PLUGGY_WEBHOOK_SECRET=gere-um-valor-aleatorio

# Cifra a senha dos certificados A1. Gere um valor aleatório longo e nunca troque depois.
CERT_SECRET=
# E-mail (Resend): chave da API e remetente com domínio verificado
RESEND_API_KEY=
EMAIL_FROM="Pro Plan System <notas@seudominio.com.br>"
APP_URL=https://pro-plan-system.vercel.app
# Segredo que a Vercel envia ao disparar o envio mensal para a contabilidade
CRON_SECRET=
